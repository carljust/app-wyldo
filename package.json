{
  "name": "wyldo",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "node scripts/visual-check.mjs",
    "build:web": "expo export --platform web",
    "format:check": "prettier --check app src tests scripts package.json app.json tsconfig.json global.d.ts",
    "test:db": "node scripts/test-database.mjs",
    "test:auth-ui": "node scripts/auth-check.mjs",
    "test:backend-ui": "node scripts/backend-check.mjs",
    "test:fixture-ui": "node scripts/fixture-ui.mjs",
    "test:navigation-ui": "node scripts/navigation-check.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.8",
    "expo-linking": "~58.0.13",
    "expo-location": "~58.0.17",
    "expo-router": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-web-browser": "~58.0.6",
    "leaflet": "^1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
