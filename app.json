{
  "expo": {
    "name": "Wyldo",
    "slug": "wyldo",
    "scheme": "wyldo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wyldo nutzt deinen Standort nur während der aktiven Navigation auf freigegebenen Wegen.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.wyldo.adventure"
    },
    "android": {
      "package": "app.wyldo.adventure"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
